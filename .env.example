# CCS Remote - Environment Configuration
# Copy this file to .env and configure your settings

# =============================================================================
# Server Configuration
# =============================================================================

# Server port (default: 8318)
CCS_PORT=8318

# Server bind address (default: 0.0.0.0 for Docker, use 127.0.0.1 for local only)
CCS_HOST=0.0.0.0

# Data directory - stores auth files, config, and state
# For Docker: /app/data
# For local: ./data
CCS_DATA_DIR=/app/data

# =============================================================================
# Authentication
# =============================================================================

# API key for accessing proxy endpoints (CHANGE THIS!)
CCS_API_KEY=your-secure-api-key-here

# Management key for admin operations (CHANGE THIS!)
CCS_MANAGEMENT_KEY=your-management-key-here

# Require API key for all requests (default: true)
# Set to false to disable authentication (NOT recommended for production)
API_KEY_REQUIRED=true

# Additional API keys (comma-separated)
# Useful for multiple clients or rotating keys
API_KEYS=

# =============================================================================
# CLIProxy Configuration
# =============================================================================

# CLIProxy internal port (default: 8317)
CCS_CLIPROXY_PORT=8317

# Custom path to CLIProxy binary
# If not set, searches in ./bin/, /app/bin/, and system PATH
CLIPROXY_BIN_PATH=

# CLIProxy bind host (default: 0.0.0.0)
# Set to 127.0.0.1 if CLIProxy should only be accessible locally
BIND_HOST=0.0.0.0
# Alternative: CLIPROXY_BIND_HOST=0.0.0.0

# =============================================================================
# CORS Configuration
# =============================================================================

# Allowed CORS origins (comma-separated, default: *)
# For production, specify your domains:
# CCS_CORS_ORIGINS=https://your-domain.com,https://app.your-domain.com
CCS_CORS_ORIGINS=*

# =============================================================================
# Claude Code Client Configuration
# These are NOT server settings, but what you should set on the client side
# =============================================================================

# On your Claude Code client, set these environment variables:
#
# For Antigravity provider:
#   ANTHROPIC_BASE_URL=https://your-server.com/proxy/api/provider/agy
#   ANTHROPIC_AUTH_TOKEN=your-api-key-here
#
# For other providers, change 'agy' to: gemini, codex, qwen, iflow, kiro, ghcp

