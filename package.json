{
  "name": "ccs-remote",
  "version": "1.0.0",
  "description": "CCS Remote Proxy Server - Deploy CLIProxy remotely for Claude Code access",
  "main": "dist/server.js",
  "scripts": {
    "build": "tsc",
    "build:ui": "cd ui && npm run build",
    "build:all": "npm run build && npm run build:ui",
    "start": "node dist/server.js",
    "dev": "tsc && node dist/server.js",
    "dev:ui": "cd ui && npm run dev",
    "typecheck": "tsc --noEmit",
    "install:ui": "cd ui && npm install"
  },
  "keywords": [
    "ccs",
    "claude",
    "proxy",
    "remote",
    "docker"
  ],
  "author": "duogxaolin",
  "license": "MIT",
  "dependencies": {
    "express": "^4.18.2",
    "cors": "^2.8.5",
    "js-yaml": "^4.1.1"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^20.19.25",
    "typescript": "^5.3.3"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}

